# ---------------------------------------------------------------------------
# Coursify environment configuration
# Copy this file to `.env` and adjust the values for your environment.
# ---------------------------------------------------------------------------

# Public URL of the app (used for redirects, Stripe callbacks and metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL connection string (docker compose exposes this by default)
DATABASE_URL=postgres://coursify:coursify@localhost:5432/coursify

# --- Optional services -----------------------------------------------------

# Redis is OPTIONAL. When set, it is used for caching and rate limiting.
# When empty, the app falls back to an in-memory implementation.
REDIS_URL=
# REDIS_URL=redis://localhost:6379

# Stripe is OPTIONAL. When empty, paid courses use a built-in demo checkout
# so the full purchase flow can still be tested without a Stripe account.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
